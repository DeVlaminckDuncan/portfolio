---
import Container from '../components/Container.astro';
import SEOHead from '../components/SEOHead.astro';
import type { JsonLdInput } from '../utils/structuredData';
import '../styles/global.css';

interface SEOImage {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  image?: SEOImage;
  structuredData?: JsonLdInput;
}

const {
  title = 'Duncan De Vlaminck',
  description = 'Personal software engineering portfolio.',
  ogType,
  image,
  structuredData,
} = Astro.props;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
const year = new Date().getFullYear();
const cloudflareWebAnalyticsToken =
  import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN?.trim();

const isCurrentPath = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEOHead
      title={title}
      description={description}
      ogType={ogType}
      image={image}
      structuredData={structuredData}
    />
    <script is:inline>
      (() => {
        const storageKey = 'portfolio-theme';
        const validThemes = ['light', 'dark'];
        const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
        let theme = systemTheme;

        try {
          const storedTheme = localStorage.getItem(storageKey);
          if (validThemes.includes(storedTheme)) {
            theme = storedTheme;
          }
        } catch {
          theme = systemTheme;
        }

        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      cloudflareWebAnalyticsToken && (
        <>
          <link rel="preconnect" href="https://static.cloudflareinsights.com" crossorigin />
          <link rel="preconnect" href="https://cloudflareinsights.com" crossorigin />
        </>
      )
    }
  </head>
  <body class="site-body">
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <Container>
        <div class="site-header__inner">
          <a class="site-brand" href="/" data-astro-prefetch aria-label="Duncan De Vlaminck home">
            Duncan De Vlaminck
          </a>

          <div class="site-header__controls">
            <button
              class="site-nav-toggle"
              type="button"
              aria-controls="primary-navigation"
              aria-expanded="false"
              aria-label="Open menu"
              data-nav-toggle
            >
              <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
                <path d="M4 7h16" />
                <path d="M4 12h16" />
                <path d="M4 17h16" />
              </svg>
            </button>

            <div class="theme-toggle">
              <button
                class="theme-toggle__button"
                type="button"
                aria-label="Theme: Light. Switch to dark mode"
                data-theme-toggle
              >
                <svg
                  aria-hidden="true"
                  data-theme-icon="light"
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                >
                  <circle cx="12" cy="12" r="4" />
                  <path d="M12 2v2" />
                  <path d="M12 20v2" />
                  <path d="m4.93 4.93 1.41 1.41" />
                  <path d="m17.66 17.66 1.41 1.41" />
                  <path d="M2 12h2" />
                  <path d="M20 12h2" />
                  <path d="m6.34 17.66-1.41 1.41" />
                  <path d="m19.07 4.93-1.41 1.41" />
                </svg>
                <svg
                  aria-hidden="true"
                  data-theme-icon="dark"
                  data-theme-icon-hidden
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                >
                  <path d="M20.3 14.6A7.6 7.6 0 0 1 9.4 3.7 8.5 8.5 0 1 0 20.3 14.6Z" />
                </svg>
              </button>
            </div>
          </div>

          <nav
            id="primary-navigation"
            class="site-nav"
            aria-label="Primary navigation"
            data-nav-panel
          >
            {
              navItems.map((item) => (
                <a
                  href={item.href}
                  aria-current={isCurrentPath(item.href) ? 'page' : undefined}
                  data-astro-prefetch
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
        </div>
      </Container>
    </header>

    <main id="main-content" class="site-main">
      <Container>
        <slot />
      </Container>
    </main>

    <footer class="site-footer">
      <Container>
        <div class="site-footer__inner">
          <p>&copy; {year} Duncan De Vlaminck</p>
          <a href="/contact/" data-astro-prefetch>Contact</a>
        </div>
      </Container>
    </footer>

    {
      cloudflareWebAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({
            token: cloudflareWebAnalyticsToken,
          })}
        />
      )
    }
    <script is:inline>
      (() => {
        const storageKey = 'portfolio-theme';
        const validThemes = ['light', 'dark'];
        const root = document.documentElement;
        const trigger = document.querySelector('[data-theme-toggle]');
        const triggerIcons = Array.from(document.querySelectorAll('[data-theme-icon]'));
        const labelByTheme = {
          light: 'Light',
          dark: 'Dark',
        };

        const systemPreference = window.matchMedia('(prefers-color-scheme: dark)');

        const normalizeStoredTheme = (theme) => (validThemes.includes(theme) ? theme : null);

        const getSystemTheme = () => (systemPreference.matches ? 'dark' : 'light');

        const readStoredTheme = () => {
          try {
            return normalizeStoredTheme(localStorage.getItem(storageKey));
          } catch {
            return null;
          }
        };

        const getEffectiveTheme = () => readStoredTheme() ?? getSystemTheme();

        const writeTheme = (theme) => {
          try {
            localStorage.setItem(storageKey, theme);
          } catch {
            return;
          }
        };

        const applyTheme = (theme) => {
          const normalizedTheme = validThemes.includes(theme) ? theme : getSystemTheme();
          const nextTheme = normalizedTheme === 'light' ? 'dark' : 'light';

          root.dataset.theme = normalizedTheme;
          trigger.setAttribute(
            'aria-label',
            `Theme: ${labelByTheme[normalizedTheme]}. Switch to ${nextTheme} mode`,
          );

          for (const icon of triggerIcons) {
            icon.toggleAttribute(
              'data-theme-icon-hidden',
              icon.dataset.themeIcon !== normalizedTheme,
            );
          }
        };

        applyTheme(getEffectiveTheme());

        trigger.addEventListener('click', (event) => {
          event.stopPropagation();
          const selectedTheme = getEffectiveTheme() === 'light' ? 'dark' : 'light';

          writeTheme(selectedTheme);
          applyTheme(selectedTheme);
        });

        systemPreference.addEventListener('change', () => {
          if (readStoredTheme() === null) {
            applyTheme(getSystemTheme());
          }
        });

        window.addEventListener('storage', (event) => {
          if (event.key === storageKey) {
            applyTheme(getEffectiveTheme());
          }
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const toggle = document.querySelector('[data-nav-toggle]');
        const panel = document.querySelector('[data-nav-panel]');
        const mobileQuery = window.matchMedia('(max-width: 40rem)');

        if (!(toggle instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) {
          return;
        }

        const getFirstNavLink = () => panel.querySelector('a');

        const setOpen = (open) => {
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          panel.toggleAttribute('hidden', !open);

          if (open) {
            const firstLink = getFirstNavLink();
            if (firstLink instanceof HTMLElement) {
              firstLink.focus();
            }
          }
        };

        const closeMenu = ({ restoreFocus = false } = {}) => {
          const wasOpen = toggle.getAttribute('aria-expanded') === 'true';
          setOpen(false);

          if (restoreFocus && wasOpen) {
            toggle.focus();
          }
        };

        const openMenu = () => {
          setOpen(true);
        };

        const syncForViewport = () => {
          if (mobileQuery.matches) {
            closeMenu();
          } else {
            toggle.setAttribute('aria-expanded', 'false');
            toggle.setAttribute('aria-label', 'Open menu');
            panel.removeAttribute('hidden');
          }
        };

        root.dataset.navEnhanced = '';
        syncForViewport();

        toggle.addEventListener('click', (event) => {
          event.stopPropagation();
          const isOpen = toggle.getAttribute('aria-expanded') === 'true';

          if (isOpen) {
            closeMenu({ restoreFocus: true });
          } else {
            openMenu();
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
            closeMenu({ restoreFocus: true });
          }
        });

        document.addEventListener('click', (event) => {
          if (toggle.getAttribute('aria-expanded') !== 'true') {
            return;
          }

          const target = event.target;
          if (!(target instanceof Node)) {
            return;
          }

          if (panel.contains(target) || toggle.contains(target)) {
            return;
          }

          closeMenu();
        });

        mobileQuery.addEventListener('change', () => {
          syncForViewport();
        });
      })();
    </script>
  </body>
</html>

<style>
  .site-body {
    display: flex;
    min-height: 100vh;
    flex-direction: column;
  }

  .skip-link {
    position: fixed;
    z-index: 10;
    top: var(--space-4);
    left: var(--space-4);
    transform: translateY(calc(-100% - var(--space-4)));
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-accent-foreground);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    padding: var(--space-2) var(--space-3);
    text-decoration: none;
    transition: transform 160ms ease;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-page);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) 0;
  }

  .site-brand {
    order: 1;
    flex: 0 1 auto;
    min-width: 0;
    color: var(--color-text);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-snug);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .site-nav {
    order: 2;
    display: flex;
    flex: 1 1 auto;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2) var(--space-4);
  }

  .site-nav[hidden] {
    display: none;
  }

  .site-header__controls {
    order: 3;
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--space-3);
  }

  .site-nav a {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-snug);
    text-decoration: none;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    background-color: var(--color-border);
    color: var(--color-text);
  }

  .site-nav a[aria-current='page'] {
    background-color: var(--color-accent);
    color: var(--color-accent-foreground);
  }

  .site-nav-toggle {
    display: none;
    width: 2.25rem;
    height: 2.25rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 0;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }

  .site-nav-toggle:hover,
  .site-nav-toggle:focus-visible {
    background: var(--color-border);
    color: var(--color-text);
  }

  .site-nav-toggle svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .theme-toggle {
    flex: 0 0 auto;
  }

  .theme-toggle__button {
    display: inline-flex;
    width: 2.25rem;
    height: 2.25rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 0;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }

  .theme-toggle__button:hover,
  .theme-toggle__button:focus-visible {
    background: var(--color-border);
    color: var(--color-text);
  }

  .theme-toggle svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .theme-toggle [data-theme-icon-hidden] {
    display: none;
  }

  .site-main {
    flex: 1;
    padding: var(--section-spacing) 0;
  }

  .site-footer {
    border-top: 1px solid var(--color-border);
  }

  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-6) 0;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer a {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  @media (max-width: 40rem) {
    .site-header__controls {
      order: 2;
      margin-left: auto;
    }

    .site-nav {
      display: none;
      order: 3;
      flex: 1 1 100%;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: var(--space-2);
    }

    html[data-nav-enhanced] .site-nav:not([hidden]) {
      display: flex;
    }

    .site-nav a {
      display: flex;
      min-height: 2.75rem;
      align-items: center;
    }

    html[data-nav-enhanced] .site-nav-toggle {
      display: inline-flex;
    }

    .site-footer__inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 40rem) and (prefers-reduced-motion: no-preference) {
    html[data-nav-enhanced] .site-nav:not([hidden]) {
      animation: site-nav-reveal 160ms ease;
    }
  }

  @keyframes site-nav-reveal {
    from {
      opacity: 0;
      transform: translateY(calc(var(--space-2) * -1));
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
